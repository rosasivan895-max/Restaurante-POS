rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return hasProfile() && profile().active == true;
    }

    function roleIs(roleName) {
      return active() && profile().role == roleName;
    }

    function isAdmin() {
      return roleIs("admin");
    }

    function canReadOrders() {
      return active() && profile().role in ["admin", "mesero", "cocina", "caja"];
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if canReadOrders();

      // Mesero o administrador pueden crear pedidos.
      allow create: if roleIs("mesero") || isAdmin();

      // Cocina, caja y administrador pueden actualizar el flujo.
      allow update: if roleIs("cocina") || roleIs("caja") || isAdmin();

      allow delete: if false;
    }
  }
}
